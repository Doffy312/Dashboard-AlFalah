# ─── Frontend Environment Variables ─────────────────────────────────
# Salin file ini menjadi .env dan sesuaikan nilainya.
# Variabel HARUS diawali dengan VITE_ agar bisa diakses di browser.

# Backend API URL (opsional)
# Kosongkan atau hapus baris ini jika frontend dan backend di-serve
# dari domain/port yang sama (menggunakan proxy atau reverse proxy).
# Isi hanya jika frontend dan backend di-deploy ke domain BERBEDA.
# Contoh: VITE_API_URL=https://api.masjid-alfalah.org
# VITE_API_URL=
