# ─── Frontend Environment Variables ─────────────────────────────────
# Salin file ini menjadi .env (atau .env.production) dan sesuaikan nilainya.
# Variabel HARUS diawali dengan VITE_ agar bisa diakses di browser.

# Backend API URL (opsional)
# Kosongkan atau hapus baris ini jika frontend dan backend di-serve
# dari host/domain yang sama (misal: Vite dev proxy lokal atau Nginx/Caddy reverse proxy).
#
# Wajib diisi jika frontend dan backend di-deploy ke domain/host BERBEDA
# (misal: Frontend di Firebase Hosting / Vercel, Backend di Render / Railway / VPS terpisah).
# Nilai bisa berupa origin backend (e.g. https://api.masjid.org) atau lengkap dengan /api.
#
# Contoh: VITE_API_URL=https://api.masjid-alfalah.org
# VITE_API_URL=
