# Environment
NODE_ENV=development
PORT=3000

# Database — MySQL connection string
DATABASE_URL=mysql://root:password@localhost:3306/mosque_dashboard

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-change-this-in-production
BETTER_AUTH_URL=http://localhost:3000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Extra CORS Origins (comma-separated, optional)
# CORS_ORIGINS=http://192.168.1.87:5173,https://staging.example.com

# SMTP (optional — email disabled if not configured)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
